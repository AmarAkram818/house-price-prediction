# Copy this file to .env and adjust as needed.

# Path to the trained pipeline (relative to backend/ or absolute)
MODEL_PATH=models/house_price.pkl

# Path to the list of allowed location buckets (for validation / dropdown source)
LOCATIONS_PATH=models/locations.json

# Allowed CORS origins for the frontend (JSON array)
CORS_ORIGINS=["http://localhost:5173"]

LOG_LEVEL=INFO
